{
  "name": "tahuisi-api",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "NODE_ENV=development bun --hot ./src/index.ts",
    "gen:auth": "bunx drizzle-kit generate --config=src/domain/auth/db/auth.db.config.ts",
    "migrate:auth": "bunx drizzle-kit migrate --config=src/domain/auth/db/auth.db.config.ts",
    "build": "bun run gen:auth && bun run migrate:auth && bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap",
    "test": "bun test",
    "start": "NODE_ENV=production bun ./dist/index.js"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@libsql/client": "^0.17.3",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "drizzle-kit": "^0.31.10"
  }
}