// Media routes
###

POST {{BASE_URL}}/media
x-internal-secret: {{INTERNAL_SECRET}}
Content-Type: multipart/form-data; boundary=boundary

--boundary
Content-Disposition: form-data; name="uploaderId"

019deee0-e455-7000-9369-7d41d8667d37
--boundary
Content-Disposition: form-data; name="altText"

Ini gambar kaguya dan mokou
--boundary
Content-Disposition: form-data; name="isPublic"

true
--boundary
Content-Disposition: form-data; name="file"; filename="mokoukaguya.jpg"
Content-Type: image/jpg

< ./files/mokoukaguya.jpg
--boundary--

###
GET {{BASE_URL}}/media/all-data
x-internal-secret: {{INTERNAL_SECRET}}

###

DELETE {{BASE_URL}}/media
x-internal-secret: {{INTERNAL_SECRET}}