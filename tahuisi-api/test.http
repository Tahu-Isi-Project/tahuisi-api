// Article routes
###

GET {{BASE_URL}}/article/headlines
x-internal-secret: {{INTERNAL_SECRET}}

###

POST {{BASE_URL}}/article
x-internal-secret: {{INTERNAL_SECRET}}
Content-Type: application/json

{
    "article": {
        "slug": "artikel-1",
        "title": "Ini Adalah Judul pertama",
        "excerpt": "Sebuah artikel pertama",
        "status": "PUBLISHED",
        "thumbnailId": "019de45f-6989-71d8-a341-084523e6e50e",
        "isLive": true,
        "body": "ini isi artikel yang nantinya akan sangat panjang sekali gak tau apalah itu"
    },
    "authorIds": 
    [
        "019de817-e6ff-7000-9a1e-7a98db4182af"
    ]
}

###

